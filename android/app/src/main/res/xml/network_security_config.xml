<?xml version="1.0" encoding="utf-8"?>
<!--
  Release: nenhum HTTP em texto claro. Produção (Railway) é HTTPS.

  Os builds de debug e profile sobrepõem este arquivo com o de
  `debug/res/xml` e `profile/res/xml`, que liberam os endereços de
  desenvolvimento (10.0.2.2, localhost). É por eles que se testa contra a API
  local: o build de profile com API_BASE_URL apontando para http://10.0.2.2:3000 (o comando está no AGENTS.md, em Como rodar).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
